{
  "name": "vocalis",
  "productName": "Vocalis",
  "version": "3.0.0",
  "description": "Sing anything in a voice you own. Fully local \u2014 train a voice and swap vocals on your own machine.",
  "author": "Vocalis",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ACS_DEV=1 electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-modules.mjs",
    "check:modules": "node scripts/check-modules.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.coverstudio.desktop",
    "productName": "Vocalis",
    "directories": {
      "output": "../dist_installers",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/dev/**",
      "!renderer/styleguide/**",
      "!renderer/app.js",
      "!renderer/styles.css"
    ],
    "extraResources": [
      {
        "from": "../engine.py",
        "to": "backend/engine.py"
      },
      {
        "from": "../server.py",
        "to": "backend/server.py"
      },
      {
        "from": "../covers_manifest.py",
        "to": "backend/covers_manifest.py"
      },
      {
        "from": "../voices_manifest.py",
        "to": "backend/voices_manifest.py"
      },
      {
        "from": "../hf_voices.py",
        "to": "backend/hf_voices.py"
      },
      {
        "from": "runtime",
        "to": "backend/runtime"
      },
      {
        "from": "../Applio",
        "to": "backend/Applio",
        "filter": [
          "!**/.venv/**",
          "!**/logs/**",
          "!**/.git/**"
        ]
      },
      {
        "from": "../.separator_models",
        "to": "data_seed/.separator_models"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
